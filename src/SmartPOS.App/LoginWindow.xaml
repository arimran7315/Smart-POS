<Window x:Class="SmartPOS.App.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sign in" Height="560" Width="460" MinWidth="320" MinHeight="320" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{DynamicResource WindowBackground}">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Border Background="{DynamicResource CardBackground}" CornerRadius="14" Padding="24" Margin="16"><StackPanel VerticalAlignment="Center">
    <TextBlock Text="{DynamicResource AppName}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
    <TextBlock Text="{Binding ModeText}" Margin="0,4,0,18" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
    <TextBlock Text="Username"/><TextBox x:Name="UsernameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="Display name" Visibility="{Binding SetupRequired, Converter={StaticResource BoolVisibility}}"/><TextBox x:Name="DisplayNameBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding SetupRequired, Converter={StaticResource BoolVisibility}}"/>
    <DockPanel Margin="4,4,4,0"><TextBlock Text="Show password" DockPanel.Dock="Right" VerticalAlignment="Center"/><CheckBox x:Name="ShowPasswordCheckBox" DockPanel.Dock="Right" Margin="4,0,8,0" VerticalAlignment="Center" Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed"/><TextBlock Text="Password" VerticalAlignment="Center"/></DockPanel>
    <Grid>
      <PasswordBox x:Name="PasswordBox" Padding="10" Margin="4" FontSize="14" GotKeyboardFocus="PasswordField_GotKeyboardFocus"/>
      <TextBox x:Name="PasswordTextBox" Padding="10" Margin="4" FontSize="14" Visibility="Collapsed" GotKeyboardFocus="PasswordField_GotKeyboardFocus"/>
    </Grid>
    <TextBlock Text="Confirm password" Visibility="{Binding SetupRequired, Converter={StaticResource BoolVisibility}}"/>
    <Grid Visibility="{Binding SetupRequired, Converter={StaticResource BoolVisibility}}">
      <PasswordBox x:Name="ConfirmBox" Padding="10" Margin="4" FontSize="14" GotKeyboardFocus="PasswordField_GotKeyboardFocus"/>
      <TextBox x:Name="ConfirmTextBox" Padding="10" Margin="4" FontSize="14" Visibility="Collapsed" GotKeyboardFocus="PasswordField_GotKeyboardFocus"/>
    </Grid>
    <Button x:Name="SubmitButton" IsDefault="True" IsEnabled="{Binding CanSubmit}" Background="{DynamicResource Accent}" Foreground="White" Click="Submit_Click" Margin="4,16,4,4">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding ButtonText}" Foreground="White" VerticalAlignment="Center"/>
        <ProgressBar IsIndeterminate="True" Width="30" Height="5" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
      </StackPanel>
    </Button>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="6,8"/>
   </StackPanel></Border>
  </ScrollViewer>
</Window>
