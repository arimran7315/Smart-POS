<Window x:Class="SmartPOS.App.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sign in" Height="560" Width="460" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="{DynamicResource WindowBackground}">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
  <Border Background="{DynamicResource CardBackground}" CornerRadius="14" Padding="30" Margin="30"><StackPanel VerticalAlignment="Center">
    <TextBlock Text="{DynamicResource AppName}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
    <TextBlock Text="{Binding ModeText}" Margin="0,4,0,18" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
    <TextBlock Text="Username"/><TextBox x:Name="UsernameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="Display name" Visibility="{Binding SetupRequired, Converter={StaticResource BoolVisibility}}"/><TextBox x:Name="DisplayNameBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding SetupRequired, Converter={StaticResource BoolVisibility}}"/>
    <TextBlock Text="Password"/><PasswordBox x:Name="PasswordBox" Padding="10" Margin="4" FontSize="14"/>
    <TextBlock Text="Confirm password" Visibility="{Binding SetupRequired, Converter={StaticResource BoolVisibility}}"/><PasswordBox x:Name="ConfirmBox" Padding="10" Margin="4" FontSize="14" Visibility="{Binding SetupRequired, Converter={StaticResource BoolVisibility}}"/>
    <Button x:Name="SubmitButton" Content="{Binding SubmitText}" IsEnabled="{Binding CanSubmit}" Background="{DynamicResource Accent}" Foreground="White" Click="Submit_Click" Margin="4,16,4,4"/>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="6,8"/>
  </StackPanel></Border>
</Window>
