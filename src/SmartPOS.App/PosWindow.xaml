<Window x:Class="SmartPOS.App.PosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Point of Sale" Height="800" Width="1250" MinHeight="620" MinWidth="900" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <Style x:Key="NotMixedTenderVisibility" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Visible"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMixedPayment}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,14"><StackPanel><TextBlock Text="Point of Sale" FontSize="28" FontWeight="Bold"/><TextBlock Text="{Binding StoreName}" Foreground="{DynamicResource SecondaryText}"/></StackPanel><TextBlock Text="{Binding CashierDisplay}" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="16"/><Button Content="Products" DockPanel.Dock="Right" Click="Products_Click"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="14" Margin="0,0,8,0"><DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="Scan a barcode or search by name / SKU" FontWeight="SemiBold"/><DockPanel><TextBox x:Name="SearchBox" Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown"/><Button Content="Add" Command="{Binding SearchProductsCommand}" Background="{DynamicResource Accent}" Foreground="White"/></DockPanel><TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Danger}" Margin="5"/><Border Visibility="{Binding HasMultipleProductMatches, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="4"><StackPanel><TextBlock Text="Choose the correct match" FontWeight="SemiBold" Margin="4"/><ListBox ItemsSource="{Binding ProductMatches}" SelectedItem="{Binding SelectedProductMatch, Mode=TwoWay}" DisplayMemberPath="DisplayLabel" MaxHeight="140"/><Button Content="Add selected product" Command="{Binding AddSelectedProductCommand}" HorizontalAlignment="Right"/></StackPanel></Border></StackPanel>
        <DataGrid x:Name="CartGrid" ItemsSource="{Binding CartLines}" SelectedItem="{Binding SelectedCartLine, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Margin="4,12"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="80"/><DataGridTextColumn x:Name="DiscountColumn" Header="Disc %" Binding="{Binding DiscountRate, UpdateSourceTrigger=PropertyChanged, StringFormat=N2, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="78"/><DataGridTextColumn Header="Price" Binding="{Binding FormattedUnitPrice}" IsReadOnly="True" Width="100"/><DataGridTextColumn Header="Line total" Binding="{Binding FormattedLineTotal}" IsReadOnly="True" Width="110"/></DataGrid.Columns></DataGrid>
      </DockPanel></Border>
      <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="20" Margin="8,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Checkout" FontSize="21" FontWeight="Bold" Margin="0,0,0,16"/><TextBlock Text="Subtotal"/><TextBlock Text="{Binding FormattedSubtotal}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="Bill discount" Margin="0,8,0,0"/><TextBox x:Name="BillDiscountBox" Text="{Binding BillDiscountText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding DiscountError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/><TextBlock Text="Discount total" Margin="0,6,0,0"/><TextBlock Text="{Binding FormattedDiscountTotal}" FontSize="18" HorizontalAlignment="Right"/><TextBlock Text="Tax" Margin="0,8,0,0"/><TextBlock Text="{Binding FormattedTaxTotal}" FontSize="18" HorizontalAlignment="Right"/><Separator Margin="0,16"/><TextBlock Text="Total"/><TextBlock Text="{Binding FormattedGrandTotal}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" Margin="0,0,0,20"/>
        <TextBlock Text="Customer"/><ComboBox x:Name="CustomerBox" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" TextSearch.TextPath="Name" ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedValuePath="CustomerId" SelectedValue="{Binding SelectedCustomerId, Mode=TwoWay}" Padding="8" Margin="4"/><TextBlock Text="Sale notes" Margin="0,8,0,0"/><TextBox x:Name="SaleNotesBox" Text="{Binding SaleNotes, UpdateSourceTrigger=PropertyChanged}" MinHeight="42" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Held sale" Margin="0,8,0,0"/><DockPanel><ComboBox x:Name="HeldSalesBox" ItemsSource="{Binding HeldSales}" DisplayMemberPath="DisplayLabel" SelectedItem="{Binding SelectedHeldSale, Mode=TwoWay}" Padding="7"/><Button Content="Resume" Command="{Binding ResumeHeldSaleCommand}"/></DockPanel><TextBlock x:Name="PaidLabel" Text="Amount received" Margin="0,8,0,0" Style="{StaticResource NotMixedTenderVisibility}"/><TextBox x:Name="PaidBox" Text="{Binding PaidText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NotMixedTenderVisibility}"/><TextBlock Text="Payment method (F4)"/><ComboBox x:Name="PaymentBox" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod, Mode=TwoWay}" Padding="8" Margin="4"/><StackPanel x:Name="MixedTenderPanel" Visibility="{Binding IsMixedPayment, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Cash allocated"/><TextBox x:Name="MixedCashBox" Text="{Binding MixedCashText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Card allocated"/><TextBox x:Name="MixedCardBox" Text="{Binding MixedCardText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><TextBlock Text="{Binding ChangeSummary}" FontSize="17" HorizontalAlignment="Right" Margin="4,12"/>
        <Button Content="Remove selected item  (Delete)" Command="{Binding RemoveProductCommand}"/><Button Content="Hold sale  (F3)" Command="{Binding HoldSaleCommand}"/><Button Content="New sale  (F5)" Command="{Binding NewSaleCommand}"/><Button Content="Clear cart" Command="{Binding ClearCartCommand}"/><Button Content="Cancel sale" Command="{Binding CancelSaleCommand}" Background="{DynamicResource Danger}" Foreground="White"/><Button Content="Complete sale" Command="{Binding CompleteSaleCommand}" IsEnabled="{Binding CanComplete}" Background="{DynamicResource Accent}" Foreground="White" FontSize="18" Padding="14"/><Button x:Name="PrintButton" Content="Print last receipt  (F8)" IsEnabled="{Binding CanPrintLastReceipt}" Click="Print_Click"/></StackPanel></ScrollViewer></Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="F1: Search   F2: Barcode input   F3: Hold sale   F4: Payment   F5: New sale   F8: Print   Delete: Remove item" Foreground="{DynamicResource SecondaryText}" Margin="4,12"/>
  </Grid>
</Window>
