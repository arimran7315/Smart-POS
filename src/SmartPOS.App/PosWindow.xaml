<Window x:Class="SmartPOS.App.PosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SmartPOS | Point of Sale" Height="800" Width="1250" MinHeight="620" MinWidth="900" WindowStartupLocation="CenterScreen" Background="#F3F6F8" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,14"><StackPanel><TextBlock Text="Point of Sale" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="StoreInfo" Foreground="#687789"/></StackPanel><TextBlock x:Name="CashierInfo" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="16"/><Button Content="Products" DockPanel.Dock="Right" Click="Products_Click"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,8,0"><DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="Scan a barcode or search by name / SKU" FontWeight="SemiBold"/><DockPanel><TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown"/><Button Content="Add" Background="#176B87" Foreground="White" Click="Add_Click"/></DockPanel><TextBlock x:Name="SearchMessage" Foreground="#A33" Margin="5"/></StackPanel>
        <DataGrid x:Name="CartGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Margin="4,12"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/><DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Line total" Binding="{Binding LineTotal, StringFormat=N2}" Width="110"/></DataGrid.Columns></DataGrid>
      </DockPanel></Border>
      <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="8,0,0,0"><StackPanel><TextBlock Text="Checkout" FontSize="21" FontWeight="Bold" Margin="0,0,0,16"/><TextBlock Text="Subtotal"/><TextBlock x:Name="SubtotalText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="Tax" Margin="0,14,0,0"/><TextBlock x:Name="TaxText" FontSize="18" HorizontalAlignment="Right"/><Separator Margin="0,16"/><TextBlock Text="Total"/><TextBlock x:Name="TotalText" FontSize="34" FontWeight="Bold" Foreground="#176B87" HorizontalAlignment="Right" Margin="0,0,0,20"/>
        <TextBlock Text="Customer"/><ComboBox x:Name="CustomerBox" Padding="8" Margin="4"><ComboBoxItem Content="Walk-in" Tag=""/></ComboBox><TextBlock Text="Amount received"/><TextBox x:Name="PaidBox" Text="0" TextChanged="PaidBox_TextChanged"/><TextBlock Text="Payment method"/><ComboBox x:Name="PaymentBox" SelectedIndex="0" SelectionChanged="PaymentBox_SelectionChanged" Padding="8" Margin="4"><ComboBoxItem Content="Cash"/><ComboBoxItem Content="Card"/><ComboBoxItem Content="Credit"/></ComboBox><TextBlock x:Name="ChangeText" Text="Change: 0.00" FontSize="17" HorizontalAlignment="Right" Margin="4,12"/>
        <Button Content="Remove selected item  (Delete)" Click="Remove_Click"/><Button Content="Clear cart  (F5)" Click="Clear_Click"/><Button Content="Complete sale  (F4)" Background="#176B87" Foreground="White" FontSize="18" Padding="14" Click="Complete_Click"/><Button x:Name="PrintButton" Content="Print last receipt" IsEnabled="False" Click="Print_Click"/></StackPanel></Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="F1: barcode/search   F4: complete sale   F5: clear cart   Delete: remove item" Foreground="#687789" Margin="4,12"/>
  </Grid>
</Window>
