<Window x:Class="SmartPOS.App.Views.QuotationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quotations" Width="1200" Height="760" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
  <DockPanel Margin="18">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14" VerticalAlignment="Center">
      <TextBlock Text="Quotations" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <TextBox Width="200" ToolTip="Search quote number or customer" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
      <ComboBox Width="130" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" ToolTip="Status"/>
      <Button Content="Search" Command="{Binding SearchCommand}"/>
      <Button Content="New quotation" Command="{Binding NewQuoteCommand}" Background="{DynamicResource Accent}" Foreground="White"/>
    </WrapPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" Margin="4,12" TextWrapping="Wrap"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- Left: saved quotations and selected quote detail -->
      <Grid Grid.Column="0" Margin="0,0,10,0">
        <Grid.RowDefinitions><RowDefinition Height="1.3*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding Quotations}" SelectedItem="{Binding SelectedQuotation, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Quote" Binding="{Binding QuoteNumber}" Width="150"/>
            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
            <DataGridTextColumn Header="Date" Binding="{Binding QuotedAtUtc, StringFormat=g}" Width="140"/>
            <DataGridTextColumn Header="Valid until" Binding="{Binding ValidUntilUtc, StringFormat=d}" Width="100"/>
            <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="100"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
          </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="12" Margin="0,10,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Selected quotation" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
              <WrapPanel>
                <TextBlock Text="Convert as" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Width="110" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding ConvertPaymentMethod}"/>
                <TextBlock Text="Paid" VerticalAlignment="Center" Margin="6,0,4,0"/>
                <TextBox Width="110" Text="{Binding ConvertPaidText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Convert to sale" Command="{Binding ConvertCommand}" Background="{DynamicResource Accent}" Foreground="White"/>
                <Button Content="Cancel quote" Command="{Binding CancelQuoteCommand}" Background="{DynamicResource Danger}" Foreground="White"/>
              </WrapPanel>
            </Border>
            <DataGrid ItemsSource="{Binding QuotationItems}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountRate, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="100"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>
      <!-- Right: quote builder -->
      <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Build quotation" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Customer (optional)"/>
            <ComboBox IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" TextSearch.TextPath="Name" ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedCustomerId, Mode=TwoWay}" Padding="8" Margin="4"/>
            <TextBlock Text="Product"/>
            <ComboBox IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" TextSearch.TextPath="Name" ItemsSource="{Binding Products}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProduct}" Padding="8" Margin="4"/>
            <WrapPanel>
              <TextBlock Text="Qty" VerticalAlignment="Center"/><TextBox Width="70" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="Disc %" VerticalAlignment="Center"/><TextBox Width="70" Text="{Binding DiscountRate, UpdateSourceTrigger=PropertyChanged}"/>
              <Button Content="Add item" Command="{Binding AddLineCommand}" Background="{DynamicResource Accent}" Foreground="White"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <WrapPanel><TextBlock Text="Bill discount" VerticalAlignment="Center"/><TextBox Width="110" Text="{Binding BillDiscount, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Valid until" VerticalAlignment="Center" Margin="8,0,0,0"/><DatePicker SelectedDate="{Binding ValidUntil}" Width="130"/></WrapPanel>
            <TextBlock Text="Notes"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap"/>
            <DockPanel Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="Total" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Total, StringFormat=N2}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="8,0"/>
              </StackPanel>
              <Button HorizontalAlignment="Left" Content="Remove selected" Command="{Binding RemoveLineCommand}"/>
            </DockPanel>
            <Button Content="Save quotation" Command="{Binding SaveQuoteCommand}" Background="{DynamicResource Accent}" Foreground="White" FontSize="15" Margin="0,8,0,0"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,10">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
              <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N2}" Width="60"/>
              <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountRate, StringFormat=N2}" Width="60"/>
              <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
