<Window x:Class="SmartPOS.App.Views.ProductsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Products" Width="1120" Height="720" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14" VerticalAlignment="Center"><TextBlock Text="Products" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Width="200" Margin="4" ToolTip="Search name, SKU, or barcode" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="135" Margin="4" ToolTip="Filter by category name" Text="{Binding CategoryFilter, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Low stock" IsChecked="{Binding LowStockOnly}" VerticalAlignment="Center" Margin="8,4"/><ComboBox Width="115" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" Margin="4" ToolTip="Sort products"/><Button Content="Search" Command="{Binding SearchCommand}"/><Button Content="New product" Command="{Binding NewCommand}" Background="{DynamicResource Accent}" Foreground="White"/></WrapPanel>
    <DataGrid x:Name="ProductGrid" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{DynamicResource CardBackground}" Margin="0,0,8,0"><DataGrid.Columns>
      <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/><DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130"/><DataGridTextColumn Header="Sale price" Binding="{Binding SalePrice, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="80"/>
    </DataGrid.Columns></DataGrid>
    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="8,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Product details" FontSize="20" FontWeight="SemiBold" Margin="4,0,4,12"/>
      <TextBlock Text="Name *"/><TextBox Text="{Binding SelectedProduct.Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="SKU *"/><TextBox Text="{Binding SelectedProduct.Sku, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Barcode"/><TextBox Text="{Binding SelectedProduct.Barcode, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Product image"/><WrapPanel><Button Content="Choose image" Click="ChooseImage_Click"/><Button Content="Remove image" Click="RemoveImage_Click"/></WrapPanel><Image x:Name="ProductImagePreview" Height="130" MaxWidth="260" Stretch="Uniform" HorizontalAlignment="Left"/><TextBlock Text="Category"/><ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProduct.CategoryId, Mode=TwoWay}" Margin="4" Padding="8"/><TextBlock Text="Manage categories" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Margin="4" Padding="8"/><DockPanel><TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"/><Button Content="New" Command="{Binding NewCategoryCommand}"/><Button Content="Save" Command="{Binding SaveCategoryCommand}"/><Button Content="Deactivate" Command="{Binding DeactivateCategoryCommand}"/></DockPanel><TextBlock Text="Brand"/><ComboBox ItemsSource="{Binding Brands}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProduct.BrandId, Mode=TwoWay}" Margin="4" Padding="8"/><TextBlock Text="Manage brands" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Brands}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedBrand, Mode=TwoWay}" Margin="4" Padding="8"/><DockPanel><TextBox Text="{Binding BrandName, UpdateSourceTrigger=PropertyChanged}"/><Button Content="New" Command="{Binding NewBrandCommand}"/><Button Content="Save" Command="{Binding SaveBrandCommand}"/><Button Content="Deactivate" Command="{Binding DeactivateBrandCommand}"/></DockPanel><TextBlock Text="Unit"/><TextBox Text="{Binding SelectedProduct.Unit, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="Purchase price"/><TextBox Text="{Binding SelectedProduct.PurchasePrice, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Sale price"/><TextBox Text="{Binding SelectedProduct.SalePrice, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Wholesale price"/><TextBox Text="{Binding SelectedProduct.WholesalePrice, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Tax rate (%)"/><TextBox Text="{Binding SelectedProduct.TaxRate, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Discount rate (%)"/><TextBox Text="{Binding SelectedProduct.DiscountRate, UpdateSourceTrigger=LostFocus}"/>
      <TextBlock Text="Current stock"/><TextBlock Text="{Binding SelectedProduct.CurrentStock}" FontSize="16" Margin="6"/><TextBlock Text="Minimum stock"/><TextBox Text="{Binding SelectedProduct.MinimumStock, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Maximum stock (0 = no limit)"/><TextBox Text="{Binding SelectedProduct.MaximumStock, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Stock adjustment (+ receive, − reduce)"/><TextBox Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Adjustment reason"/><TextBox Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Apply stock adjustment" Command="{Binding AdjustStockCommand}" HorizontalAlignment="Right"/>
      <TextBlock Text="Description"/><TextBox Text="{Binding SelectedProduct.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70"/>
      <WrapPanel HorizontalAlignment="Right"><TextBox x:Name="LabelCopiesBox" Width="55" Text="1"/><Button Content="Print barcode labels" Click="PrintBarcode_Click"/><Button Content="Deactivate" Command="{Binding DeactivateCommand}"/><Button Content="Save product" Command="{Binding SaveCommand}" Background="{DynamicResource Accent}" Foreground="White"/></WrapPanel>
    </StackPanel></ScrollViewer></Border>
    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="4,12,4,0"><Button DockPanel.Dock="Right" Content="Next →" Command="{Binding NextPageCommand}" Margin="4,0,0,0"/><TextBlock DockPanel.Dock="Right" Text="{Binding PageSummary}" VerticalAlignment="Center" Margin="8,0"/><Button DockPanel.Dock="Right" Content="← Previous" Command="{Binding PreviousPageCommand}" Margin="0,0,4,0"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
  </Grid>
</Window>
