<Window x:Class="SmartPOS.App.Views.ProductsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SmartPOS | Products" Width="1120" Height="720" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#F3F6F8">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="Products" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/><TextBox Width="280" Margin="24,0,4,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Search" Command="{Binding SearchCommand}"/><Button Content="New product" Command="{Binding NewCommand}" Background="#176B87" Foreground="White"/></StackPanel>
    <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White" Margin="0,0,8,0"><DataGrid.Columns>
      <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/><DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130"/><DataGridTextColumn Header="Sale price" Binding="{Binding SalePrice, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="80"/>
    </DataGrid.Columns></DataGrid>
    <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="8,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Product details" FontSize="20" FontWeight="SemiBold" Margin="4,0,4,12"/>
      <TextBlock Text="Name *"/><TextBox Text="{Binding SelectedProduct.Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="SKU *"/><TextBox Text="{Binding SelectedProduct.Sku, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Barcode"/><TextBox Text="{Binding SelectedProduct.Barcode, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Category"/><ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProduct.CategoryId, Mode=TwoWay}" Margin="4" Padding="8"/><DockPanel><TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Add category" Command="{Binding AddCategoryCommand}"/></DockPanel><TextBlock Text="Brand"/><ComboBox ItemsSource="{Binding Brands}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProduct.BrandId, Mode=TwoWay}" Margin="4" Padding="8"/><DockPanel><TextBox Text="{Binding BrandName, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Add brand" Command="{Binding AddBrandCommand}"/></DockPanel><TextBlock Text="Unit"/><TextBox Text="{Binding SelectedProduct.Unit, UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="Purchase price"/><TextBox Text="{Binding SelectedProduct.PurchasePrice, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Sale price"/><TextBox Text="{Binding SelectedProduct.SalePrice, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Wholesale price"/><TextBox Text="{Binding SelectedProduct.WholesalePrice, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Tax rate (%)"/><TextBox Text="{Binding SelectedProduct.TaxRate, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Discount rate (%)"/><TextBox Text="{Binding SelectedProduct.DiscountRate, UpdateSourceTrigger=LostFocus}"/>
      <TextBlock Text="Current stock"/><TextBlock Text="{Binding SelectedProduct.CurrentStock}" FontSize="16" Margin="6"/><TextBlock Text="Minimum stock"/><TextBox Text="{Binding SelectedProduct.MinimumStock, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Stock adjustment (+ receive, − reduce)"/><TextBox Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Adjustment reason"/><TextBox Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Apply stock adjustment" Command="{Binding AdjustStockCommand}" HorizontalAlignment="Right"/>
      <TextBlock Text="Description"/><TextBox Text="{Binding SelectedProduct.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70"/>
      <WrapPanel HorizontalAlignment="Right"><TextBox x:Name="LabelCopiesBox" Width="55" Text="1"/><Button Content="Print barcode labels" Click="PrintBarcode_Click"/><Button x:Name="DeactivateButton" Content="Deactivate" Click="Deactivate_Click"/><Button Content="Save product" Command="{Binding SaveCommand}" Background="#176B87" Foreground="White"/></WrapPanel>
    </StackPanel></ScrollViewer></Border>
    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Status}" Foreground="#526272" Margin="4,12,4,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
