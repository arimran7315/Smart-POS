<Window x:Class="SmartPOS.App.Views.SalesHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sales and returns" Width="1180" Height="740" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14" VerticalAlignment="Center"><TextBlock Text="Sales and returns" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Width="155" ToolTip="Invoice number" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="3"/><DatePicker Width="125" SelectedDate="{Binding FromDate}" ToolTip="From date" Margin="3"/><DatePicker Width="125" SelectedDate="{Binding ThroughDate}" ToolTip="Through date" Margin="3"/><ComboBox Width="115" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" ToolTip="Sale status" Margin="3"/><Button Content="Search" Command="{Binding SearchCommand}"/></WrapPanel>
  <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,8,0"><DataGrid.Columns><DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="150"/><DataGridTextColumn Header="Date" Binding="{Binding SoldAtUtc, StringFormat=g}" Width="150"/><DataGridTextColumn Header="Customer ID" Binding="{Binding CustomerId}" Width="85"/><DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Due" Binding="{Binding RemainingAmount, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid>
  <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="14" Margin="8,0,0,0"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button x:Name="ReprintButton" Content="Reprint selected receipt" IsEnabled="{Binding CanReprint}" Click="Reprint_Click" HorizontalAlignment="Right" Background="{DynamicResource Accent}" Foreground="White"/><TextBlock Text="Return selected item" FontWeight="SemiBold"/><DockPanel><TextBox Width="100" Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="230" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Process return" Command="{Binding ReturnCommand}" Background="{DynamicResource Accent}" Foreground="White"/></DockPanel><Separator Margin="0,10"/><TextBlock Text="Void entire sale (Administrator)" FontWeight="SemiBold"/><DockPanel><TextBox Text="{Binding VoidReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Reason for voiding this sale"/><Button Content="Void sale" Command="{Binding VoidCommand}" Background="{DynamicResource Danger}" Foreground="White"/></DockPanel></StackPanel>
   <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/><DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Tax" Binding="{Binding Tax, StringFormat=N2}" Width="85"/><DataGridTextColumn Header="Line total" Binding="{Binding Total, StringFormat=N2}" Width="100"/></DataGrid.Columns></DataGrid>
  </DockPanel></Border>
  <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="4,12,4,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="Previous" Command="{Binding PreviousPageCommand}" Margin="3,0"/>
    <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="8,0"/>
    <Button Content="Next" Command="{Binding NextPageCommand}" Margin="3,0"/>
   </StackPanel>
   <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
  </DockPanel>
 </Grid>
</Window>
