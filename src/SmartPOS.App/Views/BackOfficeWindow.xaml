<Window x:Class="SmartPOS.App.Views.BackOfficeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Operations" Width="1050" Height="700" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F3F6F8">
 <DockPanel Margin="18"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="Business operations" FontSize="26" FontWeight="Bold"/><Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"/></StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#526272" Margin="4,12" TextWrapping="Wrap"/>
  <TabControl x:Name="MainTabs">
   <TabItem x:Name="CustomersTab" Header="Customers"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/><DataGridTextColumn Header="Credit limit" Binding="{Binding CreditLimit, StringFormat=N2}" Width="100"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/></DataGrid.Columns></DataGrid>
    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="10,0,0,0"><StackPanel><TextBlock Text="Customer" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Name"/><TextBox Text="{Binding SelectedCustomer.Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Phone"/><TextBox Text="{Binding SelectedCustomer.Phone, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Email"/><TextBox Text="{Binding SelectedCustomer.Email, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Credit limit"/><TextBox Text="{Binding SelectedCustomer.CreditLimit, UpdateSourceTrigger=LostFocus}"/><CheckBox Content="Active" IsChecked="{Binding SelectedCustomer.IsActive}" Margin="6"/><WrapPanel HorizontalAlignment="Right"><Button Content="New" Command="{Binding NewCustomerCommand}"/><Button Content="Save" Command="{Binding SaveCustomerCommand}" Background="#176B87" Foreground="White"/></WrapPanel></StackPanel></Border>
   </Grid></TabItem>
   <TabItem x:Name="SuppliersTab" Header="Suppliers"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/><DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/></DataGrid.Columns></DataGrid>
    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="10,0,0,0"><StackPanel><TextBlock Text="Supplier" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Name"/><TextBox Text="{Binding SelectedSupplier.Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Phone"/><TextBox Text="{Binding SelectedSupplier.Phone, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Email"/><TextBox Text="{Binding SelectedSupplier.Email, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Address"/><TextBox Text="{Binding SelectedSupplier.Address, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Active" IsChecked="{Binding SelectedSupplier.IsActive}" Margin="6"/><WrapPanel HorizontalAlignment="Right"><Button Content="New" Command="{Binding NewSupplierCommand}"/><Button Content="Save" Command="{Binding SaveSupplierCommand}" Background="#176B87" Foreground="White"/></WrapPanel></StackPanel></Border>
   </Grid></TabItem>
   <TabItem x:Name="ExpensesTab" Header="Expenses"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DataGrid ItemsSource="{Binding RecentExpenses}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding SpentAtUtc, StringFormat=g}" Width="160"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid>
    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="10,0,0,0"><StackPanel><TextBlock Text="Record expense" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Description"/><TextBox Text="{Binding ExpenseDescription, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Category"/><TextBox Text="{Binding ExpenseCategory, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Amount"/><TextBox Text="{Binding ExpenseAmount, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Record expense" Command="{Binding RecordExpenseCommand}" Background="#176B87" Foreground="White" HorizontalAlignment="Right"/></StackPanel></Border>
   </Grid></TabItem>
   <TabItem x:Name="UsersTab" Header="Users"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Username" Binding="{Binding UserName}" Width="*"/><DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/></DataGrid.Columns></DataGrid>
    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="10,0,0,0"><StackPanel><TextBlock Text="User account" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Username"/><TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Display name"/><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Role"/><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" Margin="4" Padding="8"/><TextBlock Text="New password (leave blank to keep current)" TextWrapping="Wrap"/><PasswordBox x:Name="UserPasswordBox" PasswordChanged="UserPasswordBox_PasswordChanged" Padding="8" Margin="4"/><WrapPanel HorizontalAlignment="Right"><Button Content="New user" Command="{Binding NewCommand}" Click="NewUser_Click"/><Button Content="Deactivate" Command="{Binding DeactivateCommand}"/><Button Content="Save account" Click="SaveUser_Click" Background="#176B87" Foreground="White"/></WrapPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#526272" Margin="4,10"/></StackPanel></Border>
   </Grid></TabItem>
   <TabItem x:Name="AuditTab" Header="Activity"><DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="When (UTC)" Binding="{Binding CreatedAtUtc, StringFormat=g}" Width="160"/><DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="80"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110"/><DataGridTextColumn Header="Entity" Binding="{Binding EntityName}" Width="120"/><DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="130"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem x:Name="SettingsTab" Header="Settings and backups"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DataGrid x:Name="SettingsGrid" Grid.Row="0" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="SettingsGrid_SelectionChanged" Margin="0,0,8,0"><DataGrid.Columns><DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid>
    <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="10" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="Application settings" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Key"/><TextBox x:Name="SettingKeyBox"/><TextBlock Text="Value"/><TextBox x:Name="SettingValueBox"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="NewSettingButton" Content="New" Click="NewSetting_Click"/><Button x:Name="SaveSettingButton" Content="Save setting" Click="SaveSetting_Click" Background="#176B87" Foreground="White"/></WrapPanel><Separator Margin="4,12"/><TextBlock Text="Database backup" FontSize="16" FontWeight="SemiBold"/><WrapPanel><Button x:Name="BackupButton" Content="Create backup" Click="CreateBackup_Click"/><Button x:Name="RestoreButton" Content="Restore backup" Click="RestoreBackup_Click"/></WrapPanel></StackPanel></Border>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Configure StoreName, StoreAddress, StorePhone, Currency, ReceiptWidthMm, InvoicePrefix, and PurchasePrefix as needed. Restore creates a safety copy before replacement." Foreground="#64748B" TextWrapping="Wrap" Margin="4,12"/>
   </Grid></TabItem>
   <TabItem x:Name="CreditTab" Header="Credit payments"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid ItemsSource="{Binding CreditSales}" SelectedItem="{Binding SelectedCredit, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="180"/><DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Outstanding" Binding="{Binding Balance, StringFormat=N2}" Width="150"/></DataGrid.Columns></DataGrid>
    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="4,14"><TextBlock Text="Payment" VerticalAlignment="Center"/><TextBox Width="120" Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Width="130" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Padding="8" Margin="4"/><TextBox Width="150" ToolTip="Reference" Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Receive payment" Command="{Binding ReceivePaymentCommand}" Background="#176B87" Foreground="White"/></WrapPanel>
   </Grid></TabItem>
  </TabControl>
 </DockPanel>
</Window>
