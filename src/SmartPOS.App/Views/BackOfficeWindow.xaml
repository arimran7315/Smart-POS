<Window x:Class="SmartPOS.App.Views.BackOfficeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Operations" Width="1050" Height="700" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
 <DockPanel Margin="18"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="Business operations" FontSize="26" FontWeight="Bold"/><Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"/></StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" Margin="4,12" TextWrapping="Wrap"/>
  <TabControl x:Name="MainTabs">
   <TabItem x:Name="CustomersTab" Header="Customers"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel><TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6" ToolTip="Search name, phone, email, or address" Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}"/><DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/><DataGridTextColumn Header="Credit limit" Binding="{Binding CreditLimit, StringFormat=N2}" Width="100"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/></DataGrid.Columns></DataGrid></DockPanel>
    <Border x:Name="CustomerEditor" Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="10,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Customer" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Name"/><TextBox Text="{Binding SelectedCustomer.Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Phone"/><TextBox Text="{Binding SelectedCustomer.Phone, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Email"/><TextBox Text="{Binding SelectedCustomer.Email, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Address"/><TextBox Text="{Binding SelectedCustomer.Address, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Opening balance"/><TextBox Text="{Binding SelectedCustomer.OpeningBalance, UpdateSourceTrigger=LostFocus}"/><TextBlock Text="Credit limit"/><TextBox Text="{Binding SelectedCustomer.CreditLimit, UpdateSourceTrigger=LostFocus}"/><CheckBox Content="Active" IsChecked="{Binding SelectedCustomer.IsActive}" Margin="6"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="NewCustomerButton" Content="New" Command="{Binding NewCustomerCommand}"/><Button x:Name="SaveCustomerButton" Content="Save" Command="{Binding SaveCustomerCommand}" Background="{DynamicResource Accent}" Foreground="White"/></WrapPanel><Border x:Name="CustomerAccountPaymentPanel" Visibility="Collapsed" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,12,4,4"><StackPanel><TextBlock Text="Receive account payment" FontWeight="SemiBold"/><TextBlock Text="Amount"/><TextBox Text="{Binding CustomerAccountPaymentAmount, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Method"/><ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding CustomerAccountPaymentMethod}" Padding="8" Margin="4"/><TextBlock Text="Reference"/><TextBox Text="{Binding CustomerAccountPaymentReference, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Receive payment" Command="{Binding ReceiveCustomerAccountPaymentCommand}" HorizontalAlignment="Right" Background="{DynamicResource Accent}" Foreground="White"/></StackPanel></Border></StackPanel></ScrollViewer></Border>
   </Grid></TabItem>
   <TabItem x:Name="SuppliersTab" Header="Suppliers"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel><TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6" ToolTip="Search name, company, phone, email, or address" Text="{Binding SupplierSearch, UpdateSourceTrigger=PropertyChanged}"/><DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Company" Binding="{Binding Company}" Width="*"/><DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="130"/><DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/><DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/></DataGrid.Columns></DataGrid></DockPanel>
    <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="10,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Supplier" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Name"/><TextBox Text="{Binding SelectedSupplier.Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Company"/><TextBox Text="{Binding SelectedSupplier.Company, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Phone"/><TextBox Text="{Binding SelectedSupplier.Phone, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Email"/><TextBox Text="{Binding SelectedSupplier.Email, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Address"/><TextBox Text="{Binding SelectedSupplier.Address, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Opening balance"/><TextBox Text="{Binding SelectedSupplier.OpeningBalance, UpdateSourceTrigger=LostFocus}"/><CheckBox Content="Active" IsChecked="{Binding SelectedSupplier.IsActive}" Margin="6"/><WrapPanel HorizontalAlignment="Right"><Button Content="New" Command="{Binding NewSupplierCommand}"/><Button Content="Save" Command="{Binding SaveSupplierCommand}" Background="{DynamicResource Accent}" Foreground="White"/></WrapPanel><Border x:Name="SupplierPaymentPanel" Visibility="Collapsed" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,12,4,4"><StackPanel><TextBlock Text="Record supplier payment" FontWeight="SemiBold"/><TextBlock Text="Amount"/><TextBox Text="{Binding SupplierPaymentAmount, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Method"/><ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SupplierPaymentMethod}" Padding="8" Margin="4"/><TextBlock Text="Reference"/><TextBox Text="{Binding SupplierPaymentReference, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Record payment" Command="{Binding RecordSupplierPaymentCommand}" HorizontalAlignment="Right" Background="{DynamicResource Accent}" Foreground="White"/></StackPanel></Border></StackPanel></ScrollViewer></Border>
   </Grid></TabItem>
   <TabItem x:Name="ExpensesTab" Header="Expenses"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel><TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6" ToolTip="Search description, category, method, notes, or amount" Text="{Binding ExpenseSearch, UpdateSourceTrigger=PropertyChanged}"/><DataGrid ItemsSource="{Binding RecentExpenses}" SelectedItem="{Binding SelectedExpense, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding SpentAtUtc, StringFormat=g}" Width="160"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="110"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="120"/><DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel>
    <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="10,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding ExpenseFormTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Description"/><TextBox Text="{Binding ExpenseDescription, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Category"/><TextBox Text="{Binding ExpenseCategory, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Amount"/><TextBox Text="{Binding ExpenseAmount, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Date"/><DatePicker SelectedDate="{Binding ExpenseDate}"/><TextBlock Text="Payment method"/><ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding ExpensePaymentMethod}"/><TextBlock Text="Notes"/><TextBox Text="{Binding ExpenseNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap"/><WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="New" Command="{Binding NewExpenseCommand}"/><Button Content="Edit selected" Command="{Binding EditExpenseCommand}"/><Button Content="Delete selected" Command="{Binding DeleteExpenseCommand}" Background="{DynamicResource Danger}" Foreground="White"/><Button Content="Save expense" Command="{Binding RecordExpenseCommand}" Background="{DynamicResource Accent}" Foreground="White"/></WrapPanel></StackPanel></ScrollViewer></Border>
   </Grid></TabItem>
   <TabItem x:Name="UsersTab" Header="Users"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel><TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6" ToolTip="Search username, display name, or role" Text="{Binding UserSearch, UpdateSourceTrigger=PropertyChanged}"/><DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Username" Binding="{Binding UserName}" Width="*"/><DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/></DataGrid.Columns></DataGrid></DockPanel>
    <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="10,0,0,0"><StackPanel><TextBlock Text="User account" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Username"/><TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Display name"/><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Role"/><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" Margin="4" Padding="8"/><TextBlock Text="New password (leave blank to keep current)" TextWrapping="Wrap"/><PasswordBox x:Name="UserPasswordBox" PasswordChanged="UserPasswordBox_PasswordChanged" Padding="8" Margin="4"/><WrapPanel HorizontalAlignment="Right"><Button Content="New user" Command="{Binding NewCommand}"/><Button Content="Deactivate" Command="{Binding DeactivateCommand}"/><Button Content="Save account" Command="{Binding SaveCommand}" Background="{DynamicResource Accent}" Foreground="White"/></WrapPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="4,10"/></StackPanel></Border>
   </Grid></TabItem>
   <TabItem x:Name="AuditTab" Header="Activity"><DockPanel Margin="12"><TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6" ToolTip="Search action, entity, description, or user ID" Text="{Binding AuditSearch, UpdateSourceTrigger=PropertyChanged}"/><DataGrid ItemsSource="{Binding RecentAuditEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="When (UTC)" Binding="{Binding CreatedAtUtc, StringFormat=g}" Width="160"/><DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="80"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110"/><DataGridTextColumn Header="Entity" Binding="{Binding EntityName}" Width="120"/><DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="130"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
   <TabItem x:Name="SettingsTab" Header="Settings and backups"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DataGrid Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Settings}" SelectedItem="{Binding SelectedSetting, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,0,8,0"><DataGrid.Columns><DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid>
    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="Application settings" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Key"/><TextBox Text="{Binding SettingKey, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Value"/><TextBox Text="{Binding SettingValue, UpdateSourceTrigger=PropertyChanged}"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="NewSettingButton" Content="New" Command="{Binding NewCommand}"/><Button x:Name="SaveSettingButton" Content="Save setting" Command="{Binding SaveCommand}" Background="{DynamicResource Accent}" Foreground="White"/></WrapPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="4,10"/><Separator Margin="4,12"/><TextBlock Text="Database backup" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding LastBackupText}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="4"/><WrapPanel><Button x:Name="BackupButton" Content="Create backup" Click="CreateBackup_Click"/><Button x:Name="RestoreButton" Content="Restore backup" Click="RestoreBackup_Click"/></WrapPanel></StackPanel></Border>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Set ApplicationName to rename the application. Configure StoreName, StoreAddress, StorePhone, StoreEmail, TaxNumber, Currency, ReceiptWidthMm (58 or 80), ReceiptPrintMode (Dialog or EscPos), DefaultPrinter, InvoicePrefix, PurchasePrefix, PurchaseReturnPrefix, and InvoiceNumberFormat (use {PREFIX}, {YEAR}, and {SEQUENCE:D6}). LowStockThreshold is the default minimum for products without their own minimum stock. Restore creates a safety copy before replacement." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="4,12"/>
   </Grid></TabItem>
   <TabItem x:Name="CreditTab" Header="Credit payments"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><TextBox DockPanel.Dock="Top" Margin="0,0,0,8" Padding="6" ToolTip="Search invoice or customer" Text="{Binding CreditSearch, UpdateSourceTrigger=PropertyChanged}"/><DataGrid ItemsSource="{Binding CreditSales}" SelectedItem="{Binding SelectedCredit, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="180"/><DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Outstanding" Binding="{Binding Balance, StringFormat=N2}" Width="150"/></DataGrid.Columns></DataGrid></DockPanel>
    <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="4,14"><TextBlock Text="Payment" VerticalAlignment="Center"/><TextBox Width="120" Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Width="130" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Padding="8" Margin="4"/><TextBox Width="150" ToolTip="Reference" Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Receive payment" Command="{Binding ReceivePaymentCommand}" Background="{DynamicResource Accent}" Foreground="White"/></WrapPanel>
   </Grid></TabItem>
  </TabControl>
 </DockPanel>
</Window>
