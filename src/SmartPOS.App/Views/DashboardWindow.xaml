<Window x:Class="SmartPOS.App.Views.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dashboard" Width="1280" Height="780" MinWidth="760" MinHeight="460" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}">
 <Grid Background="{DynamicResource WindowBackground}">
 <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Grid.Column="0" Background="{DynamicResource CardBackground}" Padding="14">
  <DockPanel>
   <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="{DynamicResource AppName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="6,8,6,2"/>
    <TextBlock Text="POINT OF SALE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" Margin="8,0,8,18"/>
    <Button x:Name="PosNavButton" Content="Open POS · F1" HorizontalContentAlignment="Left" Background="{DynamicResource Accent}" Foreground="White" Click="Pos_Click"/>
    <Separator Margin="6,12"/>
    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" Margin="8,4,8,6"/>
    <Button Content="Products" HorizontalContentAlignment="Left" Click="Products_Click" x:Name="ProductsNavButton"/>
    <Button Content="Purchases" HorizontalContentAlignment="Left" Click="Purchase_Click" x:Name="PurchasesNavButton"/>
    <Button Content="Quotations" HorizontalContentAlignment="Left" Click="Quotations_Click" x:Name="QuotationsNavButton"/>
    <Button Content="Sales and returns" HorizontalContentAlignment="Left" Click="Sales_Click" x:Name="SalesNavButton"/>
    <Button Content="Shift / cash drawer" HorizontalContentAlignment="Left" Click="Shift_Click" x:Name="ShiftNavButton"/>
    <Button Content="Reports" HorizontalContentAlignment="Left" Click="Reports_Click" x:Name="ReportsNavButton"/>
    <Button Content="Operations" HorizontalContentAlignment="Left" Click="Operations_Click" x:Name="OperationsNavButton"/>
   </StackPanel></ScrollViewer>
   <StackPanel DockPanel.Dock="Bottom">
    <Button Content="Refresh dashboard" HorizontalContentAlignment="Left" Click="Refresh_Click"/>
    <TextBlock x:Name="UserInfo" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="8,8"/>
    <Button Content="Sign out" HorizontalContentAlignment="Left" Click="SignOut_Click"/>
   </StackPanel>
  </DockPanel>
 </Border>
 <ScrollViewer Grid.Column="1" Background="{DynamicResource WindowBackground}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="DashboardContent" Background="{DynamicResource WindowBackground}" Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,20"><StackPanel><TextBlock Text="TODAY AT A GLANCE" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}"/><TextBlock Text="Dashboard" FontSize="30" FontWeight="Bold"/></StackPanel></DockPanel>
  <TextBlock Grid.Row="1" Text="TODAY" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" Margin="0,0,0,10"/>
  <Grid x:Name="MetricsGrid" Grid.Row="2">
    <Border x:Name="SalesMetricCard" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Sales" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding Sales}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Today's visible sales" Foreground="{DynamicResource MutedText}"/></StackPanel></Border>
    <Border x:Name="PurchasesMetricCard" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Purchases" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding Purchases}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Today's received purchases" Foreground="{DynamicResource MutedText}"/></StackPanel></Border>
    <Border x:Name="ProfitMetricCard" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Profit" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding Profit}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,8"/><TextBlock Text="Net of tax, discounts, and recorded unit cost" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}"/></StackPanel></Border>
    <Border x:Name="ExpensesMetricCard" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Expenses" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding Expenses}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Today's recorded expenses" Foreground="{DynamicResource MutedText}"/></StackPanel></Border>
    <Border x:Name="ProductsMetricCard" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Active products" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding Products}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="In catalogue" Foreground="{DynamicResource MutedText}"/></StackPanel></Border>
    <Border x:Name="LowStockMetricCard" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Low stock" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding LowStock}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Warning}" Margin="0,8"/><TextBlock Text="At or below product minimum" Foreground="{DynamicResource MutedText}"/></StackPanel></Border>
    <Border x:Name="CustomersMetricCard" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Customers" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding Customers}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Active records" Foreground="{DynamicResource MutedText}"/></StackPanel></Border>
    <Border x:Name="SuppliersMetricCard" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Suppliers" Foreground="{DynamicResource MutedText}"/><TextBlock Text="{Binding Suppliers}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Active records" Foreground="{DynamicResource MutedText}"/></StackPanel></Border>
  </Grid>
  <Grid x:Name="ChartsGrid" Grid.Row="3" Margin="0,8,0,0">
   <Border x:Name="SalesChartCard" Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6" Padding="14"><StackPanel><TextBlock Text="Sales · last 7 days" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding SalesTrend}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Fraction}" Maximum="1" Height="12" VerticalAlignment="Center"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding IsNegative}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock Grid.Column="2" Text="{Binding Amount}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
   <Border x:Name="PurchasesChartCard" Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6" Padding="14"><StackPanel><TextBlock Text="Purchases · last 7 days" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding PurchasesTrend}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Fraction}" Maximum="1" Height="12" VerticalAlignment="Center" Foreground="{DynamicResource SuccessMuted}"/><TextBlock Grid.Column="2" Text="{Binding Amount}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
   <Border x:Name="ProfitChartCard" Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6" Padding="14"><StackPanel><TextBlock Text="Profit · last 7 days" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding ProfitTrend}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Fraction}" Maximum="1" Height="12" VerticalAlignment="Center"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding IsNegative}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock Grid.Column="2" Text="{Binding Amount}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
  </Grid>
   <Grid x:Name="RecentActivityGrid" Grid.Row="4" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="TopProductsCard" Grid.Column="0" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6,0" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Top-selling products today" FontWeight="SemiBold" Margin="0,0,0,6"/><ItemsControl ItemsSource="{Binding TopProducts}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="4,2"><TextBlock DockPanel.Dock="Right" Text="{Binding UnitsSold, StringFormat={}{0:N2} sold}" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="{Binding ProductName}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border>
   <Border x:Name="RecentSalesCard" Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6,0" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Recent sales" FontWeight="SemiBold" Margin="0,0,0,6"/><ItemsControl ItemsSource="{Binding RecentSales}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="4,2"><TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=N2}" Foreground="{DynamicResource SecondaryText}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding InvoiceNumber}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedText}" Margin="6,0,0,0"/></StackPanel></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border>
   <Border x:Name="RecentPurchasesCard" Grid.Column="2" Background="{DynamicResource CardBackground}" CornerRadius="12" Margin="6,0" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Recent purchases" FontWeight="SemiBold" Margin="0,0,0,6"/><ItemsControl ItemsSource="{Binding RecentPurchases}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="4,2"><TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=N2}" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="{Binding InvoiceNumber}"/><TextBlock Foreground="{DynamicResource MutedText}"><Run Text=" · "/><Run Text="{Binding SupplierName}"/></TextBlock></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border>
  </Grid>
  <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="{DynamicResource MutedText}" Margin="6,8"/>
 </Grid></ScrollViewer>
</Grid>
</Window>
