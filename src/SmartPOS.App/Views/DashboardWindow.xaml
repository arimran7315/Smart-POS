<Window x:Class="SmartPOS.App.Views.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SmartPOS | Dashboard" Width="1180" Height="780" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#F3F6F8">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,20"><StackPanel><TextBlock Text="{DynamicResource AppName}" FontSize="15" Foreground="#176B87"/><TextBlock Text="Dashboard" FontSize="30" FontWeight="Bold"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="UserInfo" VerticalAlignment="Center" Margin="8"/><Button Content="Refresh" Click="Refresh_Click"/><Button Content="Reports" Click="Reports_Click"/><Button Content="Sales / returns" Click="Sales_Click"/><Button Content="Purchases" Click="Purchase_Click"/><Button Content="Operations" Click="Operations_Click"/><Button Content="Products" Click="Products_Click"/><Button Content="Open POS  F1" Background="#176B87" Foreground="White" Click="Pos_Click"/></StackPanel></DockPanel>
  <TextBlock Grid.Row="1" Text="TODAY" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,10"/>
  <UniformGrid Grid.Row="2" Columns="4" Rows="2">
    <Border Background="White" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Sales" Foreground="#64748B"/><TextBlock Text="{Binding Sales}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Today's completed sales" Foreground="#64748B"/></StackPanel></Border>
    <Border Background="White" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Purchases" Foreground="#64748B"/><TextBlock Text="{Binding Purchases}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Today's received purchases" Foreground="#64748B"/></StackPanel></Border>
    <Border Background="White" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Profit" Foreground="#64748B"/><TextBlock Text="{Binding Profit}" FontSize="28" FontWeight="Bold" Foreground="#176B87" Margin="0,8"/><TextBlock Text="Net of tax, discounts, and recorded unit cost" TextWrapping="Wrap" Foreground="#64748B"/></StackPanel></Border>
    <Border Background="White" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Expenses" Foreground="#64748B"/><TextBlock Text="{Binding Expenses}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Today's recorded expenses" Foreground="#64748B"/></StackPanel></Border>
    <Border Background="White" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Active products" Foreground="#64748B"/><TextBlock Text="{Binding Products}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="In catalogue" Foreground="#64748B"/></StackPanel></Border>
    <Border Background="White" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Low stock" Foreground="#64748B"/><TextBlock Text="{Binding LowStock}" FontSize="28" FontWeight="Bold" Foreground="#B45309" Margin="0,8"/><TextBlock Text="At or below product minimum" Foreground="#64748B"/></StackPanel></Border>
    <Border Background="White" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Customers" Foreground="#64748B"/><TextBlock Text="{Binding Customers}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Active records" Foreground="#64748B"/></StackPanel></Border>
    <Border Background="White" CornerRadius="12" Margin="6" Padding="18"><StackPanel><TextBlock Text="Suppliers" Foreground="#64748B"/><TextBlock Text="{Binding Suppliers}" FontSize="28" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Active records" Foreground="#64748B"/></StackPanel></Border>
  </UniformGrid>
  <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#64748B" Margin="6,12"/>
 </Grid>
</Window>
