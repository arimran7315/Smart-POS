<Window x:Class="SmartPOS.App.Views.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dashboard" Width="1280" Height="800" MinWidth="680" MinHeight="470" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}">
 <Grid Background="{DynamicResource WindowBackground}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- ======================= SIDEBAR ======================= -->
  <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
   <DockPanel Margin="12,14,12,12">
    <!-- Brand + collapse toggle -->
    <Grid DockPanel.Dock="Top" Margin="2,0,0,10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border x:Name="BrandLogo" Grid.Column="0" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Accent}">
      <Image Source="pack://application:,,,/Assets/SmartPOS.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
     </Border>
     <StackPanel x:Name="BrandText" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
      <TextBlock Text="{DynamicResource AppName}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
      <TextBlock Text="POINT OF SALE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" Margin="0,1,0,0"/>
     </StackPanel>
     <Button x:Name="SidebarToggle" Grid.Column="2" Style="{StaticResource NavButton}" Padding="7" Margin="0" VerticalAlignment="Center" Click="SidebarToggle_Click" ToolTip="Collapse menu">
      <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
     </Button>
    </Grid>

    <!-- Primary POS action -->
    <Button x:Name="PosNavButton" DockPanel.Dock="Top" Click="Pos_Click" Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0" Padding="12,11" Margin="0,4,0,8" Cursor="Hand" HorizontalContentAlignment="Left" ToolTip="Open POS · F1">
     <Button.Template>
      <ControlTemplate TargetType="Button">
       <Border x:Name="pr" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pr" Property="Opacity" Value="0.9"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="pr" Property="Opacity" Value="0.78"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Button.Template>
     <StackPanel x:Name="PosNavStack" Orientation="Horizontal">
      <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Text="Open POS" Tag="label" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
      <TextBlock Text="F1" Tag="label" FontSize="10" Margin="8,0,0,0" Padding="5,1" VerticalAlignment="Center" Foreground="White" Opacity="0.85"/>
     </StackPanel>
    </Button>

    <!-- Bottom: user + utility actions -->
    <StackPanel DockPanel.Dock="Bottom">
     <Separator Margin="2,6"/>
     <Border x:Name="UserCard" Background="{DynamicResource NavHover}" CornerRadius="10" Padding="8" Margin="0,2,0,6">
      <StackPanel Orientation="Horizontal">
       <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentSoft}">
        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <TextBlock x:Name="UserInfo" Tag="label" TextWrapping="Wrap" MaxWidth="128" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" Margin="8,0,0,0"/>
      </StackPanel>
     </Border>
     <Button Style="{StaticResource NavButton}" Click="Refresh_Click" ToolTip="Refresh dashboard">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Refresh" Tag="label" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <Button x:Name="SignOutButton" Style="{StaticResource NavButton}" Foreground="{DynamicResource Danger}" Click="SignOut_Click" ToolTip="Sign out">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Sign out" Tag="label" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
     </Button>
    </StackPanel>

    <!-- Scrollable navigation -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock x:Name="WorkspaceHeader" Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" Margin="12,6,8,4"/>
      <Button x:Name="ProductsNavButton" Style="{StaticResource NavButton}" Click="Products_Click" ToolTip="Products">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Products" Tag="label" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Button x:Name="PurchasesNavButton" Style="{StaticResource NavButton}" Click="Purchase_Click" ToolTip="Purchases">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Purchases" Tag="label" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Button x:Name="QuotationsNavButton" Style="{StaticResource NavButton}" Click="Quotations_Click" ToolTip="Quotations">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Quotations" Tag="label" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Button x:Name="SalesNavButton" Style="{StaticResource NavButton}" Click="Sales_Click" ToolTip="Sales and returns">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Sales and returns" Tag="label" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Button x:Name="ShiftNavButton" Style="{StaticResource NavButton}" Click="Shift_Click" ToolTip="Shift / cash drawer">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Shift / cash drawer" Tag="label" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Button x:Name="ReportsNavButton" Style="{StaticResource NavButton}" Click="Reports_Click" ToolTip="Reports">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Reports" Tag="label" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </Button>
      <Button x:Name="OperationsNavButton" Style="{StaticResource NavButton}" Click="Operations_Click" ToolTip="Operations">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="24" TextAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="Operations" Tag="label" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </Button>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>

  <!-- ======================= CONTENT ======================= -->
  <ScrollViewer Grid.Column="1" Background="{DynamicResource WindowBackground}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid x:Name="DashboardContent" Background="{DynamicResource WindowBackground}" Margin="24,22,24,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="6,0,6,18">
     <StackPanel>
      <TextBlock Text="TODAY AT A GLANCE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}"/>
      <TextBlock Text="Dashboard" FontSize="30" FontWeight="Bold" Margin="0,2,0,0"/>
     </StackPanel>
    </DockPanel>

    <TextBlock Grid.Row="1" Text="TODAY" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="6,0,0,10"/>

    <Grid x:Name="MetricsGrid" Grid.Row="2">
     <Border x:Name="SalesMetricCard" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="18">
      <StackPanel>
       <DockPanel>
        <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top"><TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Sales" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="{Binding Sales}" FontSize="28" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="Today's visible sales" FontSize="12" Foreground="{DynamicResource MutedText}"/>
      </StackPanel>
     </Border>
     <Border x:Name="PurchasesMetricCard" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="18">
      <StackPanel>
       <DockPanel>
        <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SuccessSoft}" VerticalAlignment="Top"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Purchases" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="{Binding Purchases}" FontSize="28" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="Today's received purchases" FontSize="12" Foreground="{DynamicResource MutedText}"/>
      </StackPanel>
     </Border>
     <Border x:Name="ProfitMetricCard" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="18">
      <StackPanel>
       <DockPanel>
        <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Profit" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="{Binding Profit}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,10,0,4"/><TextBlock Text="Net of tax, discounts, and recorded unit cost" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedText}"/>
      </StackPanel>
     </Border>
     <Border x:Name="ExpensesMetricCard" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="18">
      <StackPanel>
       <DockPanel>
        <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource WarningSoft}" VerticalAlignment="Top"><TextBlock Text="&#xE1D3;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource Warning}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Expenses" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="{Binding Expenses}" FontSize="28" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="Today's recorded expenses" FontSize="12" Foreground="{DynamicResource MutedText}"/>
      </StackPanel>
     </Border>
     <Border x:Name="ProductsMetricCard" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="18">
      <StackPanel>
       <DockPanel>
        <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top"><TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Active products" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="{Binding Products}" FontSize="28" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="In catalogue" FontSize="12" Foreground="{DynamicResource MutedText}"/>
      </StackPanel>
     </Border>
     <Border x:Name="LowStockMetricCard" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="18">
      <StackPanel>
       <DockPanel>
        <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource WarningSoft}" VerticalAlignment="Top"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource Warning}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Low stock" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="{Binding LowStock}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Warning}" Margin="0,10,0,4"/><TextBlock Text="At or below product minimum" FontSize="12" Foreground="{DynamicResource MutedText}"/>
      </StackPanel>
     </Border>
     <Border x:Name="CustomersMetricCard" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="18">
      <StackPanel>
       <DockPanel>
        <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Customers" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="{Binding Customers}" FontSize="28" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="Active records" FontSize="12" Foreground="{DynamicResource MutedText}"/>
      </StackPanel>
     </Border>
     <Border x:Name="SuppliersMetricCard" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="18">
      <StackPanel>
       <DockPanel>
        <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SuccessSoft}" VerticalAlignment="Top"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Suppliers" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="{Binding Suppliers}" FontSize="28" FontWeight="Bold" Margin="0,10,0,4"/><TextBlock Text="Active records" FontSize="12" Foreground="{DynamicResource MutedText}"/>
      </StackPanel>
     </Border>
    </Grid>

    <Grid x:Name="ChartsGrid" Grid.Row="3" Margin="0,10,0,0">
     <Border x:Name="SalesChartCard" Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="16"><StackPanel><TextBlock Text="Sales · last 7 days" FontWeight="SemiBold" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding SalesTrend}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Fraction}" Maximum="1" Height="10" VerticalAlignment="Center"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding IsNegative}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock Grid.Column="2" Text="{Binding Amount}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     <Border x:Name="PurchasesChartCard" Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="16"><StackPanel><TextBlock Text="Purchases · last 7 days" FontWeight="SemiBold" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding PurchasesTrend}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Fraction}" Maximum="1" Height="10" VerticalAlignment="Center" Foreground="{DynamicResource SuccessMuted}"/><TextBlock Grid.Column="2" Text="{Binding Amount}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     <Border x:Name="ProfitChartCard" Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="16"><StackPanel><TextBlock Text="Profit · last 7 days" FontWeight="SemiBold" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding ProfitTrend}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Fraction}" Maximum="1" Height="10" VerticalAlignment="Center"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding IsNegative}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock Grid.Column="2" Text="{Binding Amount}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </Grid>

    <Grid x:Name="RecentActivityGrid" Grid.Row="4" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="TopProductsCard" Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="14"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Top-selling products today" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding TopProducts}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="4,3"><TextBlock DockPanel.Dock="Right" Text="{Binding UnitsSold, StringFormat={}{0:N2} sold}" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="{Binding ProductName}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border>
     <Border x:Name="RecentSalesCard" Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="14"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Recent sales" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding RecentSales}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="4,3"><TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=N2}" Foreground="{DynamicResource SecondaryText}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding InvoiceNumber}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedText}" Margin="6,0,0,0"/></StackPanel></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border>
     <Border x:Name="RecentPurchasesCard" Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14" Margin="6" Padding="14"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Recent purchases" FontWeight="SemiBold" Margin="0,0,0,8"/><ItemsControl ItemsSource="{Binding RecentPurchases}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="4,3"><TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=N2}" Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="{Binding InvoiceNumber}"/><TextBlock Foreground="{DynamicResource MutedText}"><Run Text=" · "/><Run Text="{Binding SupplierName}"/></TextBlock></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border>
    </Grid>

    <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="6,10"/>
   </Grid>
  </ScrollViewer>
 </Grid>
</Window>
