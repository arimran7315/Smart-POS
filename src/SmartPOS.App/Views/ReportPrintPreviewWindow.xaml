<Window x:Class="SmartPOS.App.Views.ReportPrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report print preview" Width="1050" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
      <Button Content="Print report" Click="Print_Click" Background="{DynamicResource Accent}" Foreground="White"/>
      <Button Content="Close" Click="Close_Click"/>
    </StackPanel>
    <FlowDocumentReader x:Name="DocumentReader" ViewingMode="Page" IsFindEnabled="False" IsPrintEnabled="False"/>
  </DockPanel>
</Window>
