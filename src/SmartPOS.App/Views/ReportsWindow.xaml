<Window x:Class="SmartPOS.App.Views.ReportsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reports" Width="1080" Height="720" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
 <DockPanel Margin="18"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14"><TextBlock Text="Reports" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,25,0"/><TextBlock Text="From" VerticalAlignment="Center"/><TextBox Width="125" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Through" VerticalAlignment="Center"/><TextBox Width="125" Text="{Binding Through, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Run report" Command="{Binding RefreshCommand}" Background="{DynamicResource Accent}" Foreground="White"/><Button Content="Print preview" Click="PrintPreview_Click" Margin="8,0,0,0"/><Button Content="Export active report" Click="Export_Click" Margin="8,0,0,0"/></WrapPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" Margin="4,12"/>
  <TabControl x:Name="ReportTabs">
   <TabItem Header="Daily sales"><Grid><Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions><ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBackground}" Margin="0,0,0,8"><ItemsControl ItemsSource="{Binding SalesChart}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Value}" Maximum="{Binding Maximum}" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><DataGrid Grid.Row="1" ItemsSource="{Binding Sales}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{DynamicResource CardBackground}"><DataGrid.Columns><DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="*"/><DataGridTextColumn Header="Sales total" Binding="{Binding SalesTotal, StringFormat=N2}" Width="200"/><DataGridTextColumn Header="Sale count" Binding="{Binding SaleCount}" Width="160"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Top products"><Grid><Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions><ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBackground}" Margin="0,0,0,8"><ItemsControl ItemsSource="{Binding TopProductsChart}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Label}"/><ProgressBar Grid.Column="1" Value="{Binding Value}" Maximum="{Binding Maximum}" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><DataGrid Grid.Row="1" ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{DynamicResource CardBackground}"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Units sold" Binding="{Binding UnitsSold}" Width="160"/><DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat=N2}" Width="200"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem x:Name="ProfitTab" Header="Profit by day"><Grid><Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions><ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBackground}" Margin="0,0,0,8"><ItemsControl ItemsSource="{Binding ProfitChart}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Value}" Maximum="{Binding Maximum}" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource Success}"/><TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><DataGrid Grid.Row="1" ItemsSource="{Binding Profit}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{DynamicResource CardBackground}"><DataGrid.Columns><DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="*"/><DataGridTextColumn Header="Net profit" Binding="{Binding Profit, StringFormat=N2}" Width="200"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Sales by cashier"><Grid><Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBackground}" Margin="0,0,0,8"><ItemsControl ItemsSource="{Binding SalesCashierChart}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Label}"/><ProgressBar Grid.Column="1" Value="{Binding Value}" Maximum="{Binding Maximum}" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><DataGrid Grid.Row="1" ItemsSource="{Binding SalesByCashier}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="*"/><DataGridTextColumn Header="Sales" Binding="{Binding Sales, StringFormat=N2}" Width="180"/><DataGridTextColumn Header="Count" Binding="{Binding SaleCount}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Sales by customer"><DataGrid ItemsSource="{Binding SalesByCustomer}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Sales" Binding="{Binding Sales, StringFormat=N2}" Width="180"/><DataGridTextColumn Header="Count" Binding="{Binding SaleCount}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Purchases by day"><Grid><Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions><ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBackground}" Margin="0,0,0,8"><ItemsControl ItemsSource="{Binding PurchasesChart}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Value}" Maximum="{Binding Maximum}" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><DataGrid Grid.Row="1" ItemsSource="{Binding PurchasesByDay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="*"/><DataGridTextColumn Header="Net purchases" Binding="{Binding NetPurchases, StringFormat=N2}" Width="180"/><DataGridTextColumn Header="Count" Binding="{Binding PurchaseCount}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Purchases by supplier"><Grid><Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBackground}" Margin="0,0,0,8"><ItemsControl ItemsSource="{Binding SupplierPurchasesChart}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Label}"/><ProgressBar Grid.Column="1" Value="{Binding Value}" Maximum="{Binding Maximum}" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><DataGrid Grid.Row="1" ItemsSource="{Binding PurchasesBySupplier}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/><DataGridTextColumn Header="Purchases" Binding="{Binding Purchases, StringFormat=N2}" Width="180"/><DataGridTextColumn Header="Count" Binding="{Binding PurchaseCount}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Expenses"><Grid><Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions><ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBackground}" Margin="0,0,0,8"><Grid><ItemsControl ItemsSource="{Binding ExpensesChart}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Label}"/><ProgressBar Grid.Column="1" Value="{Binding Value}" Maximum="{Binding Maximum}" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="No expenses in this date range." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="15"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ExpensesChart.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></ScrollViewer><DataGrid Grid.Row="1" ItemsSource="{Binding Expenses}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{DynamicResource CardBackground}"><DataGrid.Columns><DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Payment method" Binding="{Binding PaymentMethod}" Width="160"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="160"/><DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Payments"><DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="*"/><DataGridTextColumn Header="Net amount" Binding="{Binding NetAmount, StringFormat=N2}" Width="180"/><DataGridTextColumn Header="Entries" Binding="{Binding PaymentCount}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Returns"><DataGrid ItemsSource="{Binding Returns}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="120"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="Return number" Binding="{Binding ReturnNumber}" Width="180"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="140"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Tax by day"><Grid><Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBackground}" Margin="0,0,0,8"><ItemsControl ItemsSource="{Binding TaxChart}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Value="{Binding Value}" Maximum="{Binding Maximum}" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/><TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><DataGrid Grid.Row="1" ItemsSource="{Binding Tax}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="*"/><DataGridTextColumn Header="Net tax" Binding="{Binding NetTax, StringFormat=N2}" Width="180"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Customer ledger"><DataGrid ItemsSource="{Binding CustomerLedger}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/><DataGridTextColumn Header="Date (UTC)" Binding="{Binding DateUtc}" Width="160"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="150"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130"/><DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Supplier ledger"><DataGrid ItemsSource="{Binding SupplierLedger}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/><DataGridTextColumn Header="Date (UTC)" Binding="{Binding DateUtc}" Width="160"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="150"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130"/><DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Inventory valuation"><DataGrid ItemsSource="{Binding InventoryValuation}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="On hand" Binding="{Binding CurrentStock}" Width="100"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/><DataGridTextColumn Header="Unit cost" Binding="{Binding PurchaseCost, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Estimated value" Binding="{Binding EstimatedStockValue, StringFormat=N2}" Width="140"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Low stock"><Grid><Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="*"/></Grid.RowDefinitions><ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBackground}" Margin="0,0,0,8"><Grid><ItemsControl ItemsSource="{Binding LowStockChart}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="8,3"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Label}"/><ProgressBar Grid.Column="1" Value="{Binding Value}" Maximum="{Binding Maximum}" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource Danger}"/><TextBlock Grid.Column="2" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="No products are below their minimum stock." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" FontSize="15"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding LowStockChart.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></ScrollViewer><DataGrid Grid.Row="1" ItemsSource="{Binding LowStock}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{DynamicResource CardBackground}"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130"/><DataGridTextColumn Header="On hand" Binding="{Binding CurrentStock}" Width="100"/><DataGridTextColumn Header="Minimum" Binding="{Binding MinimumStock}" Width="100"/><DataGridTextColumn Header="Maximum" Binding="{Binding MaximumStock}" Width="100"/><DataGridTextColumn Header="Reorder quantity" Binding="{Binding ReorderQuantity}" Width="140"/></DataGrid.Columns></DataGrid></Grid></TabItem>   <TabItem Header="Stock movements"><DataGrid ItemsSource="{Binding StockMovements}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Date (UTC)" Binding="{Binding DateUtc}" Width="180"/><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Change" Binding="{Binding QuantityChange}" Width="100"/><DataGridTextColumn Header="Balance" Binding="{Binding BalanceAfter}" Width="100"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="130"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="150"/></DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
 </DockPanel>
</Window>
