<Window x:Class="SmartPOS.App.Views.ReportsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reports" Width="1080" Height="720" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F3F6F8">
 <DockPanel Margin="18"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14"><TextBlock Text="Reports" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,25,0"/><TextBlock Text="From" VerticalAlignment="Center"/><TextBox Width="125" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Through" VerticalAlignment="Center"/><TextBox Width="125" Text="{Binding Through, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Run report" Command="{Binding RefreshCommand}" Background="#176B87" Foreground="White"/></WrapPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#526272" Margin="4,12"/>
  <TabControl>
   <TabItem Header="Daily sales"><DataGrid ItemsSource="{Binding Sales}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White"><DataGrid.Columns><DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="*"/><DataGridTextColumn Header="Sales total" Binding="{Binding SalesTotal, StringFormat=N2}" Width="200"/><DataGridTextColumn Header="Sale count" Binding="{Binding SaleCount}" Width="160"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="Top products"><DataGrid ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Units sold" Binding="{Binding UnitsSold}" Width="160"/><DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat=N2}" Width="200"/></DataGrid.Columns></DataGrid></TabItem>
   <TabItem x:Name="ProfitTab" Header="Profit by day"><DataGrid ItemsSource="{Binding Profit}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White"><DataGrid.Columns><DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="*"/><DataGridTextColumn Header="Net profit" Binding="{Binding Profit, StringFormat=N2}" Width="200"/></DataGrid.Columns></DataGrid></TabItem>
  </TabControl>
 </DockPanel>
</Window>
