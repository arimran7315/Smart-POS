<Window x:Class="SmartPOS.App.Views.PurchaseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Purchases" Width="1050" Height="700" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#F3F6F8">
 <TabControl x:Name="PurchaseTabs" Margin="18">
  <TabItem x:Name="ReceiveTab" Header="Receive purchase">
   <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,14"><TextBlock Text="Receive purchase" FontSize="26" FontWeight="Bold"/><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"/></DockPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12"><WrapPanel VerticalAlignment="Center"><TextBlock Text="Supplier" VerticalAlignment="Center"/><ComboBox Width="220" ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSupplier}" Margin="4" Padding="8"/><TextBlock Text="Product" VerticalAlignment="Center"/><ComboBox Width="240" ItemsSource="{Binding Products}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProduct}" Margin="4" Padding="8"/><TextBlock Text="Qty" VerticalAlignment="Center"/><TextBox Width="75" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Unit cost" VerticalAlignment="Center"/><TextBox Width="100" Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Add item" Command="{Binding AddLineCommand}" Background="#176B87" Foreground="White"/></WrapPanel></Border>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="120"/><DataGridTextColumn Header="Unit cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="140"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="150"/></DataGrid.Columns></DataGrid>
    <DockPanel Grid.Row="3" Margin="4,14"><Button Content="Remove selected" Command="{Binding RemoveLineCommand}"/><TextBlock Text="{Binding Status}" Foreground="#526272" VerticalAlignment="Center" Margin="12,0"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Purchase total" FontSize="18" VerticalAlignment="Center"/><TextBlock Text="{Binding Total, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="#176B87" VerticalAlignment="Center" Margin="8,0"/><Button Content="Receive stock" Click="Receive_Click" Background="#176B87" Foreground="White" FontSize="16"/></StackPanel></DockPanel>
   </Grid>
  </TabItem>
  <TabItem x:Name="ReturnTab" Header="Return to supplier">
   <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Return received stock to a supplier" FontSize="26" FontWeight="Bold" Margin="0,0,0,12"/>
    <WrapPanel Grid.Row="1" Background="White"><TextBlock Text="Purchase" VerticalAlignment="Center" Margin="6"/><ComboBox Width="450" ItemsSource="{Binding Purchases}" SelectedItem="{Binding SelectedPurchase}" DisplayMemberPath="InvoiceNumber" Margin="6" Padding="7"/><Button Content="Load items" Command="{Binding LoadReturnItemsCommand}" Margin="6"/></WrapPanel>
    <Grid Grid.Row="2" Margin="0,10,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid Grid.Column="0" ItemsSource="{Binding ReturnableItems}" SelectedItem="{Binding SelectedReturnItem}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Qty available" Binding="{Binding QuantityRemaining}" Width="110"/><DataGridTextColumn Header="Unit cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="100"/></DataGrid.Columns></DataGrid><Border Grid.Column="1" Background="White" Padding="10" Margin="8,0,0,0"><StackPanel><TextBlock Text="Return quantity"/><TextBox Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/><Button Content="Add selected item" Command="{Binding AddReturnLineCommand}"/></StackPanel></Border></Grid>
    <DataGrid Grid.Row="3" ItemsSource="{Binding ReturnLines}" SelectedItem="{Binding SelectedReturnLine}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White" Margin="0,6"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="120"/><DataGridTextColumn Header="Unit cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="140"/><DataGridTextColumn Header="Return value" Binding="{Binding Total, StringFormat=N2}" Width="150"/></DataGrid.Columns></DataGrid>
    <DockPanel Grid.Row="4" Margin="4,10"><Button Content="Remove selected" Command="{Binding RemoveReturnLineCommand}"/><TextBlock Text="Reason" VerticalAlignment="Center" Margin="10,0,4,0"/><TextBox Width="220" Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Status}" Foreground="#526272" VerticalAlignment="Center" Margin="12,0"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Return total" FontSize="17" VerticalAlignment="Center"/><TextBlock Text="{Binding ReturnTotal, StringFormat=N2}" FontSize="20" FontWeight="Bold" Foreground="#176B87" VerticalAlignment="Center" Margin="8,0"/><Button Content="Process return" Click="Return_Click" Background="#A23D3D" Foreground="White" FontSize="16"/></StackPanel></DockPanel>
   </Grid>
  </TabItem>
 </TabControl>
</Window>
