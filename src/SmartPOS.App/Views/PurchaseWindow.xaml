<Window x:Class="SmartPOS.App.Views.PurchaseWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Purchases" Width="1050" Height="700" MinWidth="850" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
 <TabControl x:Name="PurchaseTabs" Margin="18">
  <TabItem x:Name="ReceiveTab" Header="Receive purchase">
   <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,14"><TextBlock Text="Receive purchase" FontSize="26" FontWeight="Bold"/><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"/></DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="14" Margin="0,0,0,12"><WrapPanel VerticalAlignment="Center"><TextBlock Text="Supplier" VerticalAlignment="Center"/><ComboBox Width="220" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" TextSearch.TextPath="Name" ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSupplier}" Margin="4" Padding="8"/><TextBlock Text="Product" VerticalAlignment="Center"/><ComboBox Width="240" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" TextSearch.TextPath="Name" ItemsSource="{Binding Products}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProduct}" Margin="4" Padding="8"/><TextBlock Text="Qty" VerticalAlignment="Center"/><TextBox Width="75" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Unit cost" VerticalAlignment="Center"/><TextBox Width="100" Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Discount %" VerticalAlignment="Center"/><TextBox Width="65" Text="{Binding DiscountRate, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Tax %" VerticalAlignment="Center"/><TextBox Width="65" Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Paid now" VerticalAlignment="Center"/><TextBox Width="90" IsEnabled="{Binding CanMakePayments}" Text="{Binding InitialPaymentAmount, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Width="120" IsEnabled="{Binding CanMakePayments}" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding InitialPaymentMethod}" Margin="4" Padding="6"/><TextBox Width="110" IsEnabled="{Binding CanMakePayments}" ToolTip="Payment reference (optional)" Text="{Binding InitialPaymentReference, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Add item" Command="{Binding AddLineCommand}" Background="{DynamicResource Accent}" Foreground="White"/></WrapPanel></Border>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{DynamicResource CardBackground}"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="120"/><DataGridTextColumn Header="Unit cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Discount" Binding="{Binding Discount, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Tax" Binding="{Binding Tax, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="150"/></DataGrid.Columns></DataGrid>
    <DockPanel Grid.Row="3" Margin="4,14"><Button Content="Remove selected" Command="{Binding RemoveLineCommand}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="12,0"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Purchase total" FontSize="18" VerticalAlignment="Center"/><TextBlock Text="{Binding Total, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="8,0"/><Button Content="Receive stock" Command="{Binding ReceiveCommand}" Background="{DynamicResource Accent}" Foreground="White" FontSize="16"/></StackPanel></DockPanel>
   </Grid>
  </TabItem>
  <TabItem x:Name="ReturnTab" Header="Return to supplier">
   <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Return received stock to a supplier" FontSize="26" FontWeight="Bold" Margin="0,0,0,12"/>
    <WrapPanel Grid.Row="1" Background="{DynamicResource CardBackground}"><TextBlock Text="Purchase" VerticalAlignment="Center" Margin="6"/><ComboBox Width="450" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" TextSearch.TextPath="InvoiceNumber" ItemsSource="{Binding Purchases}" SelectedItem="{Binding SelectedPurchase}" DisplayMemberPath="InvoiceNumber" Margin="6" Padding="7"/><Button Content="Load items" Command="{Binding LoadReturnItemsCommand}" Margin="6"/></WrapPanel>
    <Grid Grid.Row="2" Margin="0,10,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DataGrid Grid.Column="0" ItemsSource="{Binding ReturnableItems}" SelectedItem="{Binding SelectedReturnItem}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{DynamicResource CardBackground}"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Qty available" Binding="{Binding QuantityRemaining}" Width="110"/><DataGridTextColumn Header="Unit return value" Binding="{Binding UnitReturnValue, StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid><Border Grid.Column="1" Background="{DynamicResource CardBackground}" Padding="10" Margin="8,0,0,0"><StackPanel><TextBlock Text="Return quantity"/><TextBox Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/><Button Content="Add selected item" Command="{Binding AddReturnLineCommand}"/></StackPanel></Border></Grid>
    <DataGrid Grid.Row="3" ItemsSource="{Binding ReturnLines}" SelectedItem="{Binding SelectedReturnLine}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{DynamicResource CardBackground}" Margin="0,6"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="120"/><DataGridTextColumn Header="Unit return value" Binding="{Binding UnitReturnValue, StringFormat=N2}" Width="140"/><DataGridTextColumn Header="Return value" Binding="{Binding Total, StringFormat=N2}" Width="150"/></DataGrid.Columns></DataGrid>
    <DockPanel Grid.Row="4" Margin="4,10"><Button Content="Remove selected" Command="{Binding RemoveReturnLineCommand}"/><TextBlock Text="Reason" VerticalAlignment="Center" Margin="10,0,4,0"/><TextBox Width="220" Text="{Binding ReturnReason, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="12,0"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Return total" FontSize="17" VerticalAlignment="Center"/><TextBlock Text="{Binding ReturnTotal, StringFormat=N2}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="8,0"/><Button Content="Process return" Command="{Binding ReturnPurchaseCommand}" Background="{DynamicResource Danger}" Foreground="White" FontSize="16"/></StackPanel></DockPanel>
   </Grid>
  </TabItem>
  <TabItem x:Name="PurchasePaymentsTab" Header="Pay purchase invoices">
   <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="Outstanding supplier invoices" FontSize="26" FontWeight="Bold"/><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshOpenPurchasesCommand}"/><TextBox DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" Margin="0,0,8,0" Padding="6" ToolTip="Search invoice or supplier" Text="{Binding OutstandingSearch, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding OutstandingPurchases}" SelectedItem="{Binding SelectedOpenPurchase}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{DynamicResource CardBackground}"><DataGrid.Columns><DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="150"/><DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/><DataGridTextColumn Header="Date" Binding="{Binding PurchasedAtUtc, StringFormat=yyyy-MM-dd}" Width="130"/><DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="130"/><DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat=N2}" Width="130"/><DataGridTextColumn Header="Due" Binding="{Binding RemainingAmount, StringFormat=N2}" Width="130"/><DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" Width="100"/></DataGrid.Columns></DataGrid>
    <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="8" Padding="12" Margin="0,12,0,0"><WrapPanel VerticalAlignment="Center"><TextBlock Text="Payment amount" VerticalAlignment="Center"/><TextBox Width="120" Text="{Binding SupplierPaymentAmount, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Method" VerticalAlignment="Center"/><ComboBox Width="145" SelectedValuePath="Content" SelectedValue="{Binding SupplierPaymentMethod}" Margin="4"><ComboBoxItem Content="Cash"/><ComboBoxItem Content="Card"/><ComboBoxItem Content="Bank transfer"/></ComboBox><TextBlock Text="Reference" VerticalAlignment="Center"/><TextBox Width="180" Text="{Binding SupplierPaymentReference, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Record invoice payment" Command="{Binding RecordPurchasePaymentCommand}" Background="{DynamicResource Accent}" Foreground="White"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="12,0"/></WrapPanel></Border>
   </Grid>
  </TabItem>
 </TabControl>
</Window>
